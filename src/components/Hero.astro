---
import BrandMark from './BrandMark.astro';
import Icon from './Icon.astro';
import { HOME } from '../data/home.js';
import { UI } from '../data/ui.js';
import { localizePath, ROUTES } from '../lib/i18n.js';

/** Poster-style home hero: big AssettoCN wordmark, copy + CTAs, telemetry strip. */
const { lang } = Astro.props;
const ui = UI[lang];
const stats = HOME.stats[lang];
const worksHref = localizePath(lang, ROUTES.works);
const authorsHref = localizePath(lang, ROUTES.authors);
---
<section class="snap-section hero">
  <span class="hero__glow" aria-hidden="true"></span>
  <span class="hero__watermark" aria-hidden="true"><BrandMark width={560} /></span>

  <div class="hero__inner">
    <div class="hero__kicker">
      <span class="hero__kicker-text">{ui.hero.kicker}</span>
      <span class="hero__kicker-line" aria-hidden="true"></span>
    </div>

    <h1 class="hero__wordmark">Assetto<span class="hero__wordmark-cn">CN</span></h1>

    <div class="hero__copy">
      <div class="hero__lead">
        <div class="hero__title">{ui.hero.title}</div>
        <p class="hero__sub text-muted">{ui.hero.sub}</p>
      </div>
      <div class="hero__cta">
        <a class="btn btn-primary hero__btn" href={worksHref}>{ui.hero.ctaPrimary}<Icon name="arrow-right" size={16} /></a>
        <a class="btn btn-secondary hero__btn" href={authorsHref}>{ui.hero.ctaSecondary}</a>
      </div>
    </div>

    <div class="hero__telem">
      {stats.map((s) => (
        <div class="hero__stat">
          <span class="hero__stat-n">{s.n}</span>
          <span class="hero__stat-l">{s.l}</span>
        </div>
      ))}
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <span class="hero__scroll-text">{ui.scrollHint}</span>
    <span class="hero__scroll-chevron"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg></span>
  </div>
</section>

<style>
  .hero {
    position: relative; min-height: calc(100vh - 64px);
    display: flex; align-items: center; overflow: hidden;
  }
  .hero__glow {
    position: absolute; left: 50%; top: 12%; transform: translateX(-50%);
    width: min(1000px, 92vw); height: 560px; z-index: 0; pointer-events: none;
    background: radial-gradient(50% 50% at 50% 45%, color-mix(in srgb, var(--color-accent) 14%, transparent), transparent 72%);
    filter: blur(30px);
  }
  .hero__watermark {
    position: absolute; right: 2%; top: 8%; z-index: 0; pointer-events: none;
    width: min(560px, 46vw); opacity: .05; line-height: 0;
  }
  .hero__watermark :global(svg) { width: 100%; height: auto; }

  .hero__inner {
    position: relative; z-index: 1; width: 100%;
    max-width: 1200px; margin: 0 auto;
    padding: var(--space-8) var(--space-6) calc(var(--space-8) + 34px);
  }

  .hero__kicker { display: flex; align-items: center; gap: 14px; margin-bottom: var(--space-6); }
  .hero__kicker-text { font-family: var(--font-body); font-size: 12.5px; letter-spacing: .24em; text-transform: uppercase; color: var(--color-accent); }
  .hero__kicker-line { flex: 1; height: 1px; background: var(--color-divider); max-width: 180px; }

  .hero__wordmark {
    font-family: var(--font-heading); font-weight: var(--font-heading-weight);
    font-size: clamp(72px, 12vw, 168px); line-height: .86; letter-spacing: .005em;
    text-transform: uppercase; margin: 0;
  }
  .hero__wordmark-cn { color: var(--color-accent); }

  .hero__copy {
    display: flex; align-items: flex-end; justify-content: space-between;
    gap: var(--space-8); flex-wrap: wrap; margin-top: var(--space-6);
  }
  .hero__lead { max-width: 52ch; }
  .hero__title { font-size: 26px; font-weight: 800; margin-bottom: var(--space-3); line-height: 1.15; }
  .hero__sub { font-size: 16px; line-height: 1.7; margin: 0; }
  .hero__cta { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .hero__btn { min-height: 48px; padding-inline: 26px; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; }

  .hero__telem {
    display: flex; flex-wrap: wrap; row-gap: var(--space-2);
    margin-top: var(--space-8); border-top: 1px solid var(--color-divider); padding-top: var(--space-4);
  }
  .hero__stat { display: flex; align-items: baseline; gap: 10px; padding: 2px var(--space-6); border-left: 1px solid var(--color-divider); }
  .hero__stat:first-child { border-left: 0; padding-left: 0; }
  .hero__stat-n { font-family: var(--font-heading); font-size: 30px; color: var(--color-accent); line-height: 1; }
  .hero__stat-l { font-family: var(--font-body); font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--color-neutral-600); }

  .hero__scroll {
    position: absolute; left: 50%; bottom: 22px; transform: translateX(-50%); z-index: 1;
    display: flex; flex-direction: column; align-items: center; gap: 5px;
    color: var(--color-neutral-600);
  }
  .hero__scroll-text { font-family: var(--font-body); font-size: 10.5px; letter-spacing: .2em; text-transform: uppercase; }
  .hero__scroll-chevron { display: block; animation: acnBounce 1.9s ease-in-out infinite; }
  @keyframes acnBounce { 0%, 100% { transform: translateY(0); opacity: .7; } 50% { transform: translateY(7px); opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .hero__scroll-chevron { animation: none; } }

  @media (max-width: 560px) {
    .hero__scroll { display: none; }
    .hero__stat-n { font-size: 24px; }
  }
</style>
