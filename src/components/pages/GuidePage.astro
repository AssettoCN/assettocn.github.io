---
import { render } from 'astro:content';
import { UI } from '../../data/ui.js';
import { getGuides, getGuideEntry } from '../../lib/content.js';
import { localizePath, ROUTES } from '../../lib/i18n.js';

const { lang, slug } = Astro.props;
const ui = UI[lang];
const guides = await getGuides(lang);
const idx = guides.findIndex((g) => g.slug === slug);
const meta = guides[idx];
const prev = guides[idx - 1];
const next = guides[idx + 1];
const entry = await getGuideEntry(slug, lang);
const { Content } = await render(entry);
const guideHref = (s) => localizePath(lang, ROUTES.start + '/' + s);
---
<div class="shell fade-in guide">
  <aside class="guide-side">
    <a class="guide-side__top" href={localizePath(lang, ROUTES.start)}>← {ui.guide.toc}</a>
    <nav class="guide-side__list">
      {guides.map((g) => (
        <a href={guideHref(g.slug)} aria-current={g.slug === slug ? 'page' : undefined}>{g.title}</a>
      ))}
    </nav>
  </aside>

  <article class="guide-main">
    <div class="guide-main__head">
      <h1 class="guide-title">{meta.title}</h1>
      {meta.draft && <span class="tag guide-draft">{ui.guide.draft}</span>}
    </div>
    <div class="prose"><Content /></div>
    <nav class="guide-pager">
      {prev ? <a class="guide-pager__link" href={guideHref(prev.slug)}><span class="text-muted">{ui.guide.prev}</span>{prev.title}</a> : <span />}
      {next ? <a class="guide-pager__link guide-pager__next" href={guideHref(next.slug)}><span class="text-muted">{ui.guide.next}</span>{next.title}</a> : <span />}
    </nav>
  </article>
</div>

<style>
  .guide { padding-top: var(--space-6); padding-bottom: var(--space-8); display: grid; grid-template-columns: 220px 1fr; gap: var(--space-8); align-items: start; }
  .guide-side { position: sticky; top: 84px; display: flex; flex-direction: column; gap: var(--space-2); }
  .guide-side__top { font-size: 13px; color: var(--color-neutral-600); text-decoration: none; margin-bottom: var(--space-2); }
  .guide-side__top:hover { color: var(--color-accent); }
  .guide-side__list { display: flex; flex-direction: column; gap: 2px; }
  .guide-side__list a { font-size: 14px; color: var(--color-text); text-decoration: none; padding: 6px 10px; border-radius: var(--radius-sm); border-left: 2px solid transparent; }
  .guide-side__list a:hover { background: var(--color-surface); }
  .guide-side__list a[aria-current='page'] { color: var(--color-accent); border-left-color: var(--color-accent); font-weight: 600; }

  .guide-main { min-width: 0; }
  .guide-main__head { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: var(--space-4); }
  .guide-title { font-size: clamp(26px, 4vw, 34px); margin: 0; }
  .guide-draft { background: var(--color-accent-100); color: var(--color-accent-700); font-size: 11px; }

  .guide-pager { display: flex; justify-content: space-between; gap: var(--space-4); margin-top: var(--space-8); padding-top: var(--space-4); border-top: 1px solid var(--color-divider); }
  .guide-pager__link { display: flex; flex-direction: column; gap: 2px; font-size: 15px; color: var(--color-text); text-decoration: none; max-width: 45%; }
  .guide-pager__link :global(span) { font-size: 12px; }
  .guide-pager__next { text-align: right; margin-left: auto; }
  .guide-pager__link:hover { color: var(--color-accent); }

  /* Markdown body (rendered <Content/> — target descendants with :global). */
  .prose :global(h2) { font-size: 21px; margin: var(--space-6) 0 var(--space-3); }
  .prose :global(h3) { font-size: 17px; margin: var(--space-4) 0 var(--space-2); }
  .prose :global(p) { font-size: 15px; line-height: 1.75; margin: 0 0 var(--space-3); text-wrap: pretty; }
  .prose :global(ul), .prose :global(ol) { font-size: 15px; line-height: 1.75; padding-left: 1.4em; margin: 0 0 var(--space-3); }
  .prose :global(li) { margin: 4px 0; }
  .prose :global(a) { color: var(--color-accent-700); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(code) { font-family: ui-monospace, monospace; font-size: 13px; background: var(--color-surface); padding: 1px 6px; border-radius: 6px; }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(blockquote) { margin: 0 0 var(--space-3); padding: var(--space-2) var(--space-4); border-left: 3px solid var(--color-accent); background: var(--color-accent-100); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; }
  .prose :global(blockquote p) { margin: 0; }

  @media (max-width: 820px) {
    .guide { grid-template-columns: 1fr; gap: var(--space-4); }
    .guide-side { position: static; top: auto; border-bottom: 1px solid var(--color-divider); padding-bottom: var(--space-3); }
    .guide-side__list { flex-flow: row wrap; }
  }
</style>
