---
import Hero from '../Hero.astro';
import Pillars from '../Pillars.astro';
import StartPreview from '../StartPreview.astro';
import WorksPreview from '../WorksPreview.astro';
import AuthorsPreview from '../AuthorsPreview.astro';
import ServersPreview from '../ServersPreview.astro';
import GalleryPreview from '../GalleryPreview.astro';
import JoinCta from '../JoinCta.astro';
import { getAuthors, getServers, getGallery } from '../../lib/content.js';

// Single-page landing: poster hero + preview bands that link out to the full
// routed pages (/start, /works, /authors, /servers, /gallery).
//
// 排序理由:Mission 打头,先交代这站是什么;入门紧随其后 —— 它是导航第一项,也是新玩家
// 真正需要的第一件事;作品第三 —— 站上最大的内容集,Hero 的主 CTA 就指向 /works。
// 入门与作品此前在首页都没有位置,反倒是只有 1 条数据的服务器和 0 条的截图各占一整屏。
//
// 这里同时负责三件事,都是**按实际渲染出来的顺序**算的,不许回到组件里硬编码:
//   1. 没有内容的板块整段不渲染(首页是 mandatory snap,空板块 = 一整屏空白)
//   2. 段号 index —— 硬编码过,隐藏一段就出现 01/02/04 这种断号
//   3. 明暗交替 surface —— 也硬编码过,一换序就会连着两段同色
const { lang } = Astro.props;
const [authors, servers, shots] = await Promise.all([
  getAuthors(lang),
  getServers(lang),
  getGallery(lang),
]);

const shown = [
  'pillars',
  'start',
  'works',
  authors.length && 'authors',
  servers.length && 'servers',
  shots.length && 'gallery',
].filter(Boolean);

const at = (key) => shown.indexOf(key);
const idx = (key) => String(at(key) + 1).padStart(2, '0');
// 第一段用页面底色,之后逐段翻面。
const surface = (key) => at(key) % 2 === 1;
const band = (key) => ({ lang, index: idx(key), surface: surface(key) });
---
<div class="home">
  <Hero lang={lang} />
  <Pillars {...band('pillars')} />
  <StartPreview {...band('start')} />
  <WorksPreview {...band('works')} />
  {authors.length > 0 && <AuthorsPreview {...band('authors')} />}
  {servers.length > 0 && <ServersPreview {...band('servers')} />}
  {shots.length > 0 && <GalleryPreview {...band('gallery')} />}
  <JoinCta lang={lang} />
</div>
