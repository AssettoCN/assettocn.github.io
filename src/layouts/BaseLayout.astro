---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { localizePath } from '../lib/i18n.js';
import { UI } from '../data/ui.js';

/**
 * Site chrome + <head>. Every page renders through this.
 * Props:
 *   lang        'zh' | 'en'
 *   section     active nav item: 'home' | 'authors' | 'works' | null
 *   path        canonical (locale-agnostic) path, e.g. '/authors/kiko924'
 *   title       document title (page-specific part)
 *   description meta description
 *   snap        true on the home route → enables full-page scroll-snap
 *   noindex     true → robots noindex (404 页用;不应进索引也不该有 canonical 指向)
 */
const { lang, section = null, path = '/', title, description, snap = false, noindex = false } = Astro.props;

const site = Astro.site ?? new URL('http://localhost:4321');
const zhUrl = new URL(localizePath('zh', path), site).href;
const enUrl = new URL(localizePath('en', path), site).href;
const canonicalUrl = new URL(localizePath(lang, path), site).href;
const ogImageUrl = new URL('/og.png', site).href;
const fullTitle = title ? `${title} · AssettoCN` : 'AssettoCN · Assetto Corsa 中文社区';
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'} data-snap={snap ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // No-flash theme: apply the saved (or system) theme before first paint,
      // and flag `.js` so scroll-reveal CSS can safely start hidden.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var saved = localStorage.getItem('acn-theme');
          var theme = saved || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          d.dataset.theme = theme;
        } catch (e) { d.dataset.theme = 'light'; }
      })();
    </script>
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <>
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="zh-Hans" href={zhUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={zhUrl} />
      </>
    )}
    <meta name="theme-color" content="#e2001a" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    <meta property="og:site_name" content="AssettoCN" />
    {/* 分享卡片图。必须是绝对 URL —— QQ / 微信 / B站 / Discord 的抓取器不解析相对路径。
        图由 scripts/gen-og.mjs 生成(纯品牌:logo + 字标),全站共用一张。 */}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AssettoCN" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {/* Feed 自动发现:阅读器只要拿到站内任意一页就能找到订阅地址。每个语言一份。 */}
    <link rel="alternate" type="application/rss+xml" title={UI[lang].feed.title} href={localizePath(lang, '/rss.xml')} />
    <!-- 字体同源自托管(见 src/styles/fonts.css);正文字体提前预载,避免首屏字体闪烁。 -->
    <link rel="preload" href="/fonts/figtree-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/caprasimo-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <Nav lang={lang} section={section} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script is:inline>
      // Markdown 正文(.prose,入门指南与教程共用)里的外链改为新标签页打开。
      // 站内别处的外链都是这个行为,但 Markdown 里写不了 target —— 只能在这里补。
      // 渐进增强:没有 JS 时链接照样能点,只是同标签页跳转。
      (function () {
        document.querySelectorAll('.prose a[href^="http"]').forEach(function (a) {
          a.target = '_blank';
          a.rel = 'noopener noreferrer';
        });
      })();
    </script>
    <script is:inline>
      // Scroll reveal — reveal-once as elements enter the viewport.
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!els.length) return;
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-in'); });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (en) {
            if (!en.isIntersecting) return;
            var el = en.target;
            var step = parseInt(el.getAttribute('data-reveal-delay') || '0', 10);
            el.style.transitionDelay = (step * 90) + 'ms';
            el.classList.add('is-in');
            io.unobserve(el);
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
