---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuidePage from '../../../components/pages/GuidePage.astro';
import { guideSlugs, getGuides } from '../../../lib/content.js';
import { articleJsonLd } from '../../../lib/jsonld.js';

export async function getStaticPaths() {
  const slugs = await guideSlugs('en');
  return slugs.map((slug) => ({ params: { slug } }));
}

const lang = 'en';
const { slug } = Astro.params;
const guides = await getGuides(lang);
const meta = guides.find((g) => g.slug === slug);
---
<BaseLayout lang={lang} section="start" path={`/start/${slug}`} title={meta?.title} description={meta?.summary}
  jsonLd={meta && articleJsonLd({ title: meta.title, description: meta.summary, url: `/start/${slug}`, lang, datePublished: meta.updated })}>
  <GuidePage lang={lang} slug={slug} />
</BaseLayout>
