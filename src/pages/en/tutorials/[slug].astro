---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TutorialPage from '../../../components/pages/TutorialPage.astro';
import { tutorialSlugs, getTutorials } from '../../../lib/content.js';
import { articleJsonLd, breadcrumbJsonLd } from '../../../lib/jsonld.js';

export async function getStaticPaths() {
  const slugs = await tutorialSlugs('en');
  return slugs.map((slug) => ({ params: { slug } }));
}

const lang = 'en';
const { slug } = Astro.params;
const url = `/tutorials/${slug}`;
const all = await getTutorials(lang);
const meta = all.find((t) => t.slug === slug);
const jsonLd = meta
  ? [
      articleJsonLd({ title: meta.title, description: meta.summary, url, lang, datePublished: meta.updated }),
      breadcrumbJsonLd({ lang, section: 'tutorials', name: meta.title, url }),
    ]
  : null;
---
<BaseLayout lang={lang} section="tutorials" path={url} title={meta?.title} description={meta?.summary} jsonLd={jsonLd}>
  <TutorialPage lang={lang} slug={slug} />
</BaseLayout>
