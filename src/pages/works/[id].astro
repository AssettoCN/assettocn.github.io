---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkDetailPage from '../../components/pages/WorkDetailPage.astro';
import { getWork, workIds } from '../../lib/content.js';
import { workJsonLd, breadcrumbJsonLd } from '../../lib/jsonld.js';

export async function getStaticPaths() {
  const ids = await workIds();
  return ids.map((id) => ({ params: { id } }));
}

const lang = 'zh';
const { id } = Astro.params;
const url = `/works/${id}`;
const { work, author } = await getWork(id, lang);
---
<BaseLayout lang={lang} section="works" path={url} title={work.title} description={work.desc}
  jsonLd={[
    workJsonLd({ work, author, url, lang }),
    breadcrumbJsonLd({ lang, section: 'works', name: work.title, url }),
  ]}>
  <WorkDetailPage lang={lang} id={id} />
</BaseLayout>
